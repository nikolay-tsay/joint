<Shell
    x:Class="Joint.Mobile.AppShell"
    xmlns:start="clr-namespace:Joint.Mobile.Features.Start"
    xmlns:auth="clr-namespace:Joint.Mobile.Features.Auth"
    xmlns:home="clr-namespace:Joint.Mobile.Features.Home"
    Title="Joint"
    FlyoutBehavior="Disabled">

    <!-- Start decides between login and home, depending on whether a session exists. -->
    <ShellContent Route="start" ContentTemplate="{DataTemplate start:StartPage}" />
    <ShellContent Route="login" ContentTemplate="{DataTemplate auth:LoginPage}" />
    <ShellContent Route="home" ContentTemplate="{DataTemplate home:HomePage}" />

</Shell>
