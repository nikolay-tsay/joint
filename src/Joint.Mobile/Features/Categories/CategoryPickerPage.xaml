<ContentPage
    x:Class="Joint.Mobile.Features.Categories.CategoryPickerPage"
    xmlns:categories="clr-namespace:Joint.Mobile.Features.Categories"
    x:DataType="categories:CategoryPickerViewModel"
    Shell.NavBarIsVisible="False"
    Shell.TabBarIsVisible="False"
    BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}">

    <Grid RowDefinitions="Auto,*">

        <!-- The page's own heading with the way back; Shell's navigation bar stays off. -->
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="4" Margin="16,24,16,0">
            <Label
                Text="‹"
                FontSize="30"
                Padding="0,0,12,4"
                VerticalOptions="Center"
                SemanticProperties.Description="Back"
                TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding GoBackCommand}" />
                </Label.GestureRecognizers>
            </Label>
            <Label Grid.Column="1" Text="Category" FontSize="24" FontFamily="OpenSansSemibold" VerticalOptions="Center" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16,12,16,24" Spacing="12">
                <Label
                    Text="{Binding Error}"
                    Style="{StaticResource ErrorText}"
                    IsVisible="{Binding Error, Converter={StaticResource HasText}}" />

                <!-- Which payments the choice applies to. -->
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="{Binding Payee}" Style="{StaticResource RowTitle}" LineBreakMode="WordWrap" />
                        <Label Text="The category goes to every payment containing" Style="{StaticResource Caption}" />
                        <Border Style="{StaticResource Field}">
                            <Entry
                                Text="{Binding MatchText}"
                                Placeholder="Text every payment has in common"
                                IsSpellCheckEnabled="False"
                                IsTextPredictionEnabled="False"
                                ReturnType="Done" />
                        </Border>
                        <Label
                            Text="Shorten it if the bank adds something that changes each time, such as a reference number."
                            Style="{StaticResource Caption}" />
                    </VerticalStackLayout>
                </Border>

                <!-- The categories: tap one to choose it. "Edit" turns the list into one for
                     removing whole categories, each asking in its row before anything goes. -->
                <Border Style="{StaticResource Card}" Padding="8">
                    <VerticalStackLayout>
                        <Grid ColumnDefinitions="*,Auto" Padding="8,6,8,2">
                            <Label Text="Categories" Style="{StaticResource Caption}" VerticalOptions="Center" />
                            <Label
                                Grid.Column="1"
                                Text="{Binding EditLabel}"
                                FontSize="14"
                                FontFamily="OpenSansSemibold"
                                Padding="8,4,0,4"
                                VerticalOptions="Center"
                                TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ToggleEditingCommand}" />
                                </Label.GestureRecognizers>
                            </Label>
                        </Grid>
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Choices}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="categories:CategoryChoice">
                                    <VerticalStackLayout Padding="8,13" Spacing="10">
                                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                                            <Grid.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding ChooseCommand, Source={RelativeSource AncestorType={x:Type categories:CategoryPickerViewModel}}, x:DataType=categories:CategoryPickerViewModel}"
                                                    CommandParameter="{Binding .}" />
                                            </Grid.GestureRecognizers>
                                            <Label Text="{Binding Name}" FontSize="16" />
                                            <Label
                                                Grid.Column="1"
                                                Text="✓"
                                                FontSize="16"
                                                IsVisible="{Binding IsCurrent}"
                                                TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                                            <!-- While editing: how many payees, and the way to remove them all. -->
                                            <HorizontalStackLayout
                                                Grid.Column="2"
                                                Spacing="12"
                                                IsVisible="{Binding IsEditing, Source={RelativeSource AncestorType={x:Type categories:CategoryPickerViewModel}}, x:DataType=categories:CategoryPickerViewModel}">
                                                <Label Text="{Binding Usage}" Style="{StaticResource Caption}" VerticalOptions="Center" />
                                                <Label
                                                    Text="Delete"
                                                    FontSize="14"
                                                    FontFamily="OpenSansSemibold"
                                                    VerticalOptions="Center"
                                                    TextColor="{AppThemeBinding Light={StaticResource Negative}, Dark={StaticResource NegativeDark}}">
                                                    <Label.GestureRecognizers>
                                                        <TapGestureRecognizer
                                                            Command="{Binding StartRemoveCategoryCommand, Source={RelativeSource AncestorType={x:Type categories:CategoryPickerViewModel}}, x:DataType=categories:CategoryPickerViewModel}"
                                                            CommandParameter="{Binding .}" />
                                                    </Label.GestureRecognizers>
                                                </Label>
                                            </HorizontalStackLayout>
                                        </Grid>
                                        <VerticalStackLayout Spacing="8" IsVisible="{Binding IsConfirmingRemove}">
                                            <Label Text="{Binding RemoveQuestion}" Style="{StaticResource Caption}" />
                                            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                                <Button
                                                    Text="Delete"
                                                    Style="{StaticResource DangerButton}"
                                                    Command="{Binding ConfirmRemoveCategoryCommand, Source={RelativeSource AncestorType={x:Type categories:CategoryPickerViewModel}}, x:DataType=categories:CategoryPickerViewModel}"
                                                    CommandParameter="{Binding .}" />
                                                <Button
                                                    Grid.Column="1"
                                                    Text="Keep"
                                                    Style="{StaticResource SecondaryButton}"
                                                    Command="{Binding CancelRemoveCategoryCommand, Source={RelativeSource AncestorType={x:Type categories:CategoryPickerViewModel}}, x:DataType=categories:CategoryPickerViewModel}"
                                                    CommandParameter="{Binding .}" />
                                            </Grid>
                                        </VerticalStackLayout>
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- A category of your own. -->
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Your own category" Style="{StaticResource RowTitle}" />
                        <Border Style="{StaticResource Field}">
                            <Entry
                                Text="{Binding NewName}"
                                Placeholder="Name of a new category"
                                MaxLength="50"
                                ReturnType="Done"
                                ReturnCommand="{Binding AddCommand}" />
                        </Border>
                        <Button Text="Add and choose it" Style="{StaticResource SecondaryButton}" Command="{Binding AddCommand}" />
                        <Label
                            Text="It stays in the list for as long as at least one payee uses it."
                            Style="{StaticResource Caption}" />
                    </VerticalStackLayout>
                </Border>

                <Button
                    Text="Remove the category"
                    Style="{StaticResource DangerButton}"
                    IsVisible="{Binding CanRemove}"
                    Command="{Binding RemoveCommand}" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>

</ContentPage>
