<ContentPage
    x:Class="Joint.Mobile.Features.Home.HomePage"
    xmlns:home="clr-namespace:Joint.Mobile.Features.Home"
    x:DataType="home:HomeViewModel"
    Title="Joint">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Sign out" Command="{Binding SignOutCommand}" />
    </ContentPage.ToolbarItems>

    <RefreshView IsRefreshing="{Binding IsBusy}" Command="{Binding LoadCommand}">
        <ScrollView>
            <VerticalStackLayout Padding="24" Spacing="12">
                <Label Text="{Binding Greeting}" FontSize="28" FontAttributes="Bold" />
                <Label
                    Text="{Binding Error}"
                    TextColor="Red"
                    IsVisible="{Binding Error, Converter={StaticResource HasText}}" />

                <Label Text="Accounts" FontSize="18" FontAttributes="Bold" Margin="0,16,0,0" />
                <Label
                    Text="No accounts yet. Connect Lunch Flow, then pull down to refresh after a minute."
                    IsVisible="{Binding HasNoAccounts}" />
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Accounts}" Spacing="12">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="home:AccountItem">
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                                <Label Text="{Binding Title}" FontAttributes="Bold" />
                                <Label Grid.Column="1" Text="{Binding Balance}" FontAttributes="Bold" />
                                <Label Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Subtitle}" FontSize="12" />
                            </Grid>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Connections}" Spacing="4">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <Label Text="{Binding .}" FontSize="12" />
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
                <Button Text="Connect Lunch Flow" Command="{Binding ConnectLunchFlowCommand}" />

                <Label Text="{Binding HouseholdName}" FontSize="18" FontAttributes="Bold" Margin="0,16,0,0" />
                <Label Text="Members" FontAttributes="Bold" />
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Members}" Spacing="4">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <Label Text="{Binding .}" />
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <Button Text="Invite someone" Margin="0,16,0,0" Command="{Binding InviteCommand}" />
                <Button Text="Join a household" Command="{Binding JoinCommand}" />
                <Button
                    Text="Leave household"
                    Command="{Binding LeaveCommand}"
                    IsVisible="{Binding IsShared}" />
            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>

</ContentPage>
