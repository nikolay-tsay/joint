<ContentPage
    x:Class="Joint.Mobile.Features.Home.HomePage"
    xmlns:home="clr-namespace:Joint.Mobile.Features.Home"
    x:DataType="home:HomeViewModel"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}">

    <RefreshView IsRefreshing="{Binding IsRefreshing}" Command="{Binding LoadCommand}">
        <ScrollView x:Name="Scroller">
            <VerticalStackLayout Padding="12,24,12,24" Spacing="12">
                <Label Text="{Binding Greeting}" FontSize="24" FontFamily="OpenSansSemibold" Margin="4,0" />

                <Border Style="{StaticResource HeroCard}">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Total balance" TextColor="White" Opacity="0.8" FontSize="13" />
                        <Label Text="{Binding Total}" TextColor="White" FontSize="32" FontFamily="OpenSansSemibold" />
                        <Label
                            Text="{Binding OtherTotals}"
                            TextColor="White"
                            Opacity="0.8"
                            FontSize="14"
                            IsVisible="{Binding OtherTotals, Converter={StaticResource HasText}}" />

                        <!-- Whose money it is: each member's part of the total above. -->
                        <VerticalStackLayout Spacing="6" Margin="0,10,0,0" IsVisible="{Binding HasOwnerTotals}">
                            <BoxView HeightRequest="1" Color="White" Opacity="0.3" BackgroundColor="Transparent" />
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding OwnerTotals}" Spacing="4">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="home:OwnerTotalItem">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                            <Label Text="{Binding Name}" TextColor="White" Opacity="0.85" FontSize="14" LineBreakMode="TailTruncation" />
                                            <Label Grid.Column="1" Text="{Binding Amount}" TextColor="White" FontSize="14" FontFamily="OpenSansSemibold" />
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <Label
                    Text="{Binding Error}"
                    Style="{StaticResource ErrorText}"
                    IsVisible="{Binding Error, Converter={StaticResource HasText}}" />

                <Border Style="{StaticResource Card}" IsVisible="{Binding HasNoAccounts}">
                    <Label
                        Text="No accounts yet. Connect a bank from the Profile tab, then pull down here to refresh."
                        Style="{StaticResource Caption}" />
                </Border>

                <!-- One tile per kind of account: Everyday, Savings, Investments. -->
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Sections}" Spacing="12">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="home:AccountSection">
                            <!-- Tight padding, so the account rows inside get nearly the tile's full width;
                                 the heading keeps its own margin to stay aligned with other cards. -->
                            <Border Style="{StaticResource Card}" Padding="8">
                                <VerticalStackLayout Spacing="10">
                                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12" Margin="8,8,8,0">
                                        <Label
                                            Text="{Binding Title}"
                                            Style="{StaticResource SectionTitle}"
                                            Margin="0"
                                            VerticalOptions="Center" />
                                        <Label
                                            Grid.Column="1"
                                            Text="{Binding Total}"
                                            FontSize="18"
                                            FontFamily="OpenSansSemibold"
                                            HorizontalTextAlignment="End" />
                                        <!-- Investments: what the holdings have gained or lost in total. -->
                                        <Label
                                            Grid.Row="1"
                                            Grid.Column="1"
                                            Text="{Binding ProfitLoss}"
                                            FontSize="13"
                                            FontFamily="OpenSansSemibold"
                                            HorizontalTextAlignment="End"
                                            IsVisible="{Binding HasProfitLoss}"
                                            TextColor="{AppThemeBinding Light={StaticResource Positive}, Dark={StaticResource PositiveDark}}">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsLoss}" Value="True">
                                                    <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Negative}, Dark={StaticResource NegativeDark}}" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </Grid>

                                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Accounts}" Spacing="8">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="home:AccountItem">
                                                <!-- Set slightly into the tile, so accounts read apart from its total. -->
                                                <Border Style="{StaticResource InsetRow}">
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer
                                                        Command="{Binding OpenAccountCommand, Source={RelativeSource AncestorType={x:Type home:HomeViewModel}}, x:DataType=home:HomeViewModel}"
                                                        CommandParameter="{Binding .}" />
                                                </Border.GestureRecognizers>
                                                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="2">
                                                    <Label Text="{Binding Title}" Style="{StaticResource RowTitle}" />
                                                    <Label
                                                        Grid.Column="1"
                                                        Text="{Binding Balance}"
                                                        FontSize="15"
                                                        VerticalOptions="Center" />
                                                    <Label
                                                        Grid.Row="1"
                                                        Grid.ColumnSpan="2"
                                                        Text="{Binding Subtitle}"
                                                        Style="{StaticResource Caption}" />
                                                </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <Label
                    Text="To move an account to Savings or Investments, open it and change its account type."
                    Style="{StaticResource Caption}"
                    Margin="4,0"
                    IsVisible="{Binding HasAccounts}" />
            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>

</ContentPage>
