<ContentPage
    x:Class="Joint.Mobile.Features.Profile.ProfilePage"
    xmlns:profile="clr-namespace:Joint.Mobile.Features.Profile"
    x:DataType="profile:ProfileViewModel"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}">

    <RefreshView IsRefreshing="{Binding IsRefreshing}" Command="{Binding LoadCommand}">
        <ScrollView x:Name="Scroller">
            <VerticalStackLayout Padding="16,24,16,24" Spacing="12">

                <!-- Who you are -->
                <Border Style="{StaticResource Card}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                        <Border
                            WidthRequest="56"
                            HeightRequest="56"
                            StrokeThickness="0"
                            StrokeShape="Ellipse"
                            Background="{StaticResource BrandGradient}">
                            <Grid>
                                <Label
                                    Text="{Binding Initial}"
                                    TextColor="White"
                                    FontSize="24"
                                    FontFamily="OpenSansSemibold"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center" />
                                <!-- Covers the initial once the picture has loaded. -->
                                <Image Source="{Binding AvatarUrl}" Aspect="AspectFill" />
                            </Grid>
                        </Border>
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                            <Label Text="{Binding DisplayName}" FontSize="20" FontFamily="OpenSansSemibold" />
                            <Label Text="{Binding Email}" Style="{StaticResource Caption}" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <Label
                    Text="{Binding Error}"
                    Style="{StaticResource ErrorText}"
                    Margin="4,0"
                    IsVisible="{Binding Error, Converter={StaticResource HasText}}" />

                <!-- Who you share with -->
                <Label Text="Household" Style="{StaticResource SectionTitle}" />
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="{Binding HouseholdName}" Style="{StaticResource RowTitle}" />
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Members}" Spacing="8">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="profile:MemberItem">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                        <Border
                                            WidthRequest="32"
                                            HeightRequest="32"
                                            StrokeThickness="0"
                                            StrokeShape="Ellipse"
                                            BackgroundColor="{AppThemeBinding Light={StaticResource AvatarBackground}, Dark={StaticResource AvatarBackgroundDark}}">
                                            <Grid>
                                                <Label
                                                    Text="{Binding Initial}"
                                                    FontSize="14"
                                                    FontFamily="OpenSansSemibold"
                                                    HorizontalOptions="Center"
                                                    VerticalOptions="Center"
                                                    TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                                                <Image Source="{Binding AvatarUrl}" Aspect="AspectFill" />
                                            </Grid>
                                        </Border>
                                        <Label Grid.Column="1" Text="{Binding Name}" FontSize="15" VerticalOptions="Center" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                        <Label
                            Text="Everyone in a household sees the same accounts and transactions."
                            Style="{StaticResource Caption}" />

                        <!-- The card's buttons, swapped for one of the panels below while it is open. -->
                        <VerticalStackLayout Spacing="8" IsVisible="{Binding IsHouseholdMenuOpen}">
                            <Button Text="Invite someone" Style="{StaticResource PrimaryButton}" Command="{Binding InviteCommand}" />
                            <Button Text="Join with a code" Style="{StaticResource SecondaryButton}" Command="{Binding StartJoinCommand}" />
                            <Button
                                Text="Leave household"
                                Style="{StaticResource DangerButton}"
                                Command="{Binding StartLeaveCommand}"
                                IsVisible="{Binding IsShared}" />
                        </VerticalStackLayout>

                        <!-- Invite: the code, shown in place. -->
                        <VerticalStackLayout Spacing="12" IsVisible="{Binding IsInviteOpen}">
                            <Border Style="{StaticResource Field}" Padding="16">
                                <Label
                                    Text="{Binding InvitationCode}"
                                    FontSize="28"
                                    FontFamily="OpenSansSemibold"
                                    CharacterSpacing="3"
                                    HorizontalOptions="Center"
                                    TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                            </Border>
                            <Label Text="{Binding InvitationHint}" Style="{StaticResource Caption}" />
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                <Button Text="Share" Style="{StaticResource PrimaryButton}" Command="{Binding ShareInvitationCommand}" />
                                <Button Grid.Column="1" Text="Copy" Style="{StaticResource SecondaryButton}" Command="{Binding CopyInvitationCommand}" />
                            </Grid>
                            <Button Text="Done" Style="{StaticResource QuietButton}" Command="{Binding CloseHouseholdPanelCommand}" />
                        </VerticalStackLayout>

                        <!-- Join: a field for the code. -->
                        <VerticalStackLayout Spacing="12" IsVisible="{Binding IsJoinOpen}">
                            <Label
                                Text="Enter the invitation code you were given. You will leave your current household and see everything in theirs; they will see your accounts too."
                                Style="{StaticResource Caption}" />
                            <Border Style="{StaticResource Field}">
                                <Entry
                                    x:Name="JoinCodeEntry"
                                    Text="{Binding JoinCode}"
                                    Placeholder="ABCD-EFGH"
                                    FontSize="18"
                                    CharacterSpacing="2"
                                    Keyboard="Text"
                                    IsSpellCheckEnabled="False"
                                    IsTextPredictionEnabled="False"
                                    ReturnType="Done"
                                    ReturnCommand="{Binding ConfirmJoinCommand}" />
                            </Border>
                            <Label
                                Text="{Binding JoinError}"
                                Style="{StaticResource ErrorText}"
                                IsVisible="{Binding JoinError, Converter={StaticResource HasText}}" />
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                <Button Text="Join" Style="{StaticResource PrimaryButton}" Command="{Binding ConfirmJoinCommand}" />
                                <Button Grid.Column="1" Text="Cancel" Style="{StaticResource SecondaryButton}" Command="{Binding CloseHouseholdPanelCommand}" />
                            </Grid>
                        </VerticalStackLayout>

                        <!-- Leave: confirm in place. -->
                        <VerticalStackLayout Spacing="12" IsVisible="{Binding IsLeaveOpen}">
                            <Label
                                Text="Leave this household? You will go back to one of your own. The others will no longer see your accounts, and you will no longer see theirs."
                                Style="{StaticResource Caption}" />
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                <Button Text="Leave" Style="{StaticResource DangerOutlineButton}" Command="{Binding ConfirmLeaveCommand}" />
                                <Button Grid.Column="1" Text="Stay" Style="{StaticResource SecondaryButton}" Command="{Binding CloseHouseholdPanelCommand}" />
                            </Grid>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Where the data comes from -->
                <Label Text="Connections" Style="{StaticResource SectionTitle}" />
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="12">
                        <Label
                            Text="Nothing is connected yet. Connect a bank to see your accounts and transactions."
                            Style="{StaticResource Caption}"
                            IsVisible="{Binding HasNoConnections}" />
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Connections}" Spacing="12">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="profile:ConnectionItem">
                                    <VerticalStackLayout Spacing="8">
                                        <!-- Tapping the row opens it; "Remove" shows only then. -->
                                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="2">
                                            <Grid.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding ToggleConnectionCommand, Source={RelativeSource AncestorType={x:Type profile:ProfileViewModel}}, x:DataType=profile:ProfileViewModel}"
                                                    CommandParameter="{Binding .}" />
                                            </Grid.GestureRecognizers>
                                            <Label Text="{Binding Title}" Style="{StaticResource RowTitle}" />
                                            <!-- Which accounts it brought: what tells two connections to one bank apart. -->
                                            <Label Grid.Row="1" Text="{Binding Accounts}" Style="{StaticResource Caption}" IsVisible="{Binding HasAccounts}" />
                                            <Label Grid.Row="2" Text="{Binding Status}" Style="{StaticResource Caption}">
                                                <Label.Triggers>
                                                    <DataTrigger TargetType="Label" Binding="{Binding HasProblem}" Value="True">
                                                        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Negative}, Dark={StaticResource NegativeDark}}" />
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>
                                            <Button
                                                Grid.Column="1"
                                                Grid.RowSpan="3"
                                                Text="Remove"
                                                Style="{StaticResource DangerButton}"
                                                Padding="8,0"
                                                VerticalOptions="Center"
                                                IsVisible="{Binding CanStartRemove}"
                                                Command="{Binding StartRemoveCommand, Source={RelativeSource AncestorType={x:Type profile:ProfileViewModel}}, x:DataType=profile:ProfileViewModel}"
                                                CommandParameter="{Binding .}" />
                                        </Grid>

                                        <!-- Development aid; hidden in Release builds. -->
                                        <Button
                                            Text="Sync now"
                                            Style="{StaticResource SecondaryButton}"
                                            IsVisible="{Binding CanSyncNow}"
                                            Command="{Binding SyncNowCommand, Source={RelativeSource AncestorType={x:Type profile:ProfileViewModel}}, x:DataType=profile:ProfileViewModel}"
                                            CommandParameter="{Binding .}" />

                                        <!-- Remove: confirm in place, under the row. -->
                                        <VerticalStackLayout Spacing="8" IsVisible="{Binding IsConfirmingRemove}">
                                            <Label
                                                Text="Remove this connection? Its accounts and transactions will be deleted from Joint for everyone in your household. Nothing changes at your bank."
                                                Style="{StaticResource Caption}" />
                                            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                                <Button
                                                    Text="Remove"
                                                    Style="{StaticResource DangerOutlineButton}"
                                                    Command="{Binding ConfirmRemoveCommand, Source={RelativeSource AncestorType={x:Type profile:ProfileViewModel}}, x:DataType=profile:ProfileViewModel}"
                                                    CommandParameter="{Binding .}" />
                                                <Button
                                                    Grid.Column="1"
                                                    Text="Keep"
                                                    Style="{StaticResource SecondaryButton}"
                                                    Command="{Binding CancelRemoveCommand, Source={RelativeSource AncestorType={x:Type profile:ProfileViewModel}}, x:DataType=profile:ProfileViewModel}"
                                                    CommandParameter="{Binding .}" />
                                            </Grid>
                                        </VerticalStackLayout>
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>

                        <Button
                            Text="Connect"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding StartConnectCommand}"
                            IsVisible="{Binding IsConnectClosed}" />

                        <!-- Connect, step 1: pick where the data comes from. -->
                        <VerticalStackLayout Spacing="8" IsVisible="{Binding IsChoosingProvider}">
                            <Label Text="Choose what to connect" Style="{StaticResource Caption}" />
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Providers}" Spacing="8">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="profile:ProviderOption">
                                        <Border Style="{StaticResource InsetRow}">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding ChooseProviderCommand, Source={RelativeSource AncestorType={x:Type profile:ProfileViewModel}}, x:DataType=profile:ProfileViewModel}"
                                                    CommandParameter="{Binding .}" />
                                            </Border.GestureRecognizers>
                                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="2">
                                                <Label Text="{Binding Name}" Style="{StaticResource RowTitle}" />
                                                <Label Grid.Row="1" Text="{Binding Description}" Style="{StaticResource Caption}" />
                                                <Label
                                                    Grid.Column="1"
                                                    Grid.RowSpan="2"
                                                    Text="›"
                                                    FontSize="22"
                                                    VerticalOptions="Center"
                                                    TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                            <Button Text="Cancel" Style="{StaticResource QuietButton}" Command="{Binding CancelConnectCommand}" />
                        </VerticalStackLayout>

                        <!-- Connect, step 2 for Lunch Flow: a field for the key. -->
                        <VerticalStackLayout Spacing="12" IsVisible="{Binding IsLunchFlowOpen}">
                            <Label Text="Lunch Flow" Style="{StaticResource RowTitle}" />
                            <Label
                                Text="Paste the API key from your Lunch Flow API destination. It is stored encrypted and only used to read your accounts."
                                Style="{StaticResource Caption}" />
                            <Border Style="{StaticResource Field}">
                                <Entry
                                    x:Name="LunchFlowKeyEntry"
                                    Text="{Binding LunchFlowKey}"
                                    Placeholder="Lunch Flow API key"
                                    IsPassword="True"
                                    IsSpellCheckEnabled="False"
                                    IsTextPredictionEnabled="False"
                                    ReturnType="Done"
                                    ReturnCommand="{Binding ConfirmConnectCommand}" />
                            </Border>
                            <Label
                                Text="{Binding ConnectError}"
                                Style="{StaticResource ErrorText}"
                                IsVisible="{Binding ConnectError, Converter={StaticResource HasText}}" />
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="8" IsVisible="{Binding IsNotConnecting}">
                                <Button Text="Connect" Style="{StaticResource PrimaryButton}" Command="{Binding ConfirmConnectCommand}" />
                                <Button Grid.Column="1" Text="Cancel" Style="{StaticResource SecondaryButton}" Command="{Binding CancelConnectCommand}" />
                            </Grid>
                            <!-- While the provider checks the credential: the buttons give way to a spinner and what is being waited for. -->
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" IsVisible="{Binding IsConnecting}">
                                <ActivityIndicator IsRunning="{Binding IsConnecting}" HeightRequest="22" WidthRequest="22" VerticalOptions="Center" />
                                <Label Grid.Column="1" Text="{Binding ConnectProgress}" Style="{StaticResource Caption}" VerticalOptions="Center" />
                            </Grid>
                        </VerticalStackLayout>

                        <!-- Connect, step 2 for Fio: a field for the token. -->
                        <VerticalStackLayout Spacing="12" IsVisible="{Binding IsFioOpen}">
                            <Label Text="Fio banka" Style="{StaticResource RowTitle}" />
                            <Label
                                Text="In Fio internet banking open Settings, then API, and create a token that can only watch the account. Paste it here; it is stored encrypted. The first sync takes about half a minute. A token is for one account: to add another Fio account, connect again with that account's token. A new token for an account already here replaces its old one."
                                Style="{StaticResource Caption}" />
                            <Border Style="{StaticResource Field}">
                                <Entry
                                    x:Name="FioTokenEntry"
                                    Text="{Binding FioToken}"
                                    Placeholder="Fio API token"
                                    IsPassword="True"
                                    IsSpellCheckEnabled="False"
                                    IsTextPredictionEnabled="False"
                                    ReturnType="Done"
                                    ReturnCommand="{Binding ConfirmFioCommand}" />
                            </Border>
                            <Label
                                Text="{Binding ConnectError}"
                                Style="{StaticResource ErrorText}"
                                IsVisible="{Binding ConnectError, Converter={StaticResource HasText}}" />
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="8" IsVisible="{Binding IsNotConnecting}">
                                <Button Text="Connect" Style="{StaticResource PrimaryButton}" Command="{Binding ConfirmFioCommand}" />
                                <Button Grid.Column="1" Text="Cancel" Style="{StaticResource SecondaryButton}" Command="{Binding CancelConnectCommand}" />
                            </Grid>
                            <!-- While the provider checks the credential: the buttons give way to a spinner and what is being waited for. -->
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" IsVisible="{Binding IsConnecting}">
                                <ActivityIndicator IsRunning="{Binding IsConnecting}" HeightRequest="22" WidthRequest="22" VerticalOptions="Center" />
                                <Label Grid.Column="1" Text="{Binding ConnectProgress}" Style="{StaticResource Caption}" VerticalOptions="Center" />
                            </Grid>
                        </VerticalStackLayout>

                        <!-- Connect, step 2 for Trading 212: key and secret. -->
                        <VerticalStackLayout Spacing="12" IsVisible="{Binding IsTrading212Open}">
                            <Label Text="Trading 212" Style="{StaticResource RowTitle}" />
                            <Label
                                Text="In the Trading 212 app, open Settings, then API, and generate a key with only the Account data and Portfolio permissions. Paste the key and the secret here. They are stored encrypted and can only read; they cannot trade."
                                Style="{StaticResource Caption}" />
                            <Border Style="{StaticResource Field}">
                                <Entry
                                    x:Name="Trading212KeyEntry"
                                    Text="{Binding Trading212Key}"
                                    Placeholder="API key"
                                    IsSpellCheckEnabled="False"
                                    IsTextPredictionEnabled="False"
                                    ReturnType="Next" />
                            </Border>
                            <Border Style="{StaticResource Field}">
                                <Entry
                                    Text="{Binding Trading212Secret}"
                                    Placeholder="API secret"
                                    IsPassword="True"
                                    IsSpellCheckEnabled="False"
                                    IsTextPredictionEnabled="False"
                                    ReturnType="Done"
                                    ReturnCommand="{Binding ConfirmTrading212Command}" />
                            </Border>
                            <Label
                                Text="{Binding ConnectError}"
                                Style="{StaticResource ErrorText}"
                                IsVisible="{Binding ConnectError, Converter={StaticResource HasText}}" />
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="8" IsVisible="{Binding IsNotConnecting}">
                                <Button Text="Connect" Style="{StaticResource PrimaryButton}" Command="{Binding ConfirmTrading212Command}" />
                                <Button Grid.Column="1" Text="Cancel" Style="{StaticResource SecondaryButton}" Command="{Binding CancelConnectCommand}" />
                            </Grid>
                            <!-- While the provider checks the credential: the buttons give way to a spinner and what is being waited for. -->
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" IsVisible="{Binding IsConnecting}">
                                <ActivityIndicator IsRunning="{Binding IsConnecting}" HeightRequest="22" WidthRequest="22" VerticalOptions="Center" />
                                <Label Grid.Column="1" Text="{Binding ConnectProgress}" Style="{StaticResource Caption}" VerticalOptions="Center" />
                            </Grid>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <Label Text="Security" Style="{StaticResource SectionTitle}" />
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="App lock" Style="{StaticResource RowTitle}" />
                        <Label Text="{Binding LockSummary}" Style="{StaticResource Caption}" />
                        <!-- The settings themselves are on their own page, so nothing here can be tapped by mistake. -->
                        <Button Text="Security settings" Style="{StaticResource SecondaryButton}" Command="{Binding OpenSecurityCommand}" />
                    </VerticalStackLayout>
                </Border>

                <Label Text="Help" Style="{StaticResource SectionTitle}" />
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="How the numbers work" Style="{StaticResource RowTitle}" />
                        <Label
                            Text="What the budget, goals, charts and balances mean, how each is worked out and where the data comes from."
                            Style="{StaticResource Caption}" />
                        <Button Text="Open the guide" Style="{StaticResource SecondaryButton}" Command="{Binding OpenGuideCommand}" />
                    </VerticalStackLayout>
                </Border>

                <Button
                    Text="Sign out"
                    Style="{StaticResource DangerButton}"
                    Margin="0,12,0,0"
                    Command="{Binding SignOutNowCommand}" />
            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>

</ContentPage>
