<ContentPage
    x:Class="Joint.Mobile.Features.Transactions.TransactionsPage"
    xmlns:transactions="clr-namespace:Joint.Mobile.Features.Transactions"
    xmlns:common="clr-namespace:Joint.Mobile.Common"
    x:DataType="transactions:TransactionsViewModel"
    Title="{Binding Title}"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}">

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- The page's own heading. Shell's navigation bar is off: it tints the strip behind the
             clock purple, which no other page has. Opened from an account, the heading carries the
             way back that the bar used to. It sits above the list, not in the list's header, where
             its top spacing was lost and it ran into the status bar. -->
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="4" Margin="16,24,16,0">
            <Label
                Text="‹"
                FontSize="30"
                Padding="0,0,12,4"
                VerticalOptions="Center"
                IsVisible="{Binding IsAccountView}"
                SemanticProperties.Description="Back"
                TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding GoBackCommand}" />
                </Label.GestureRecognizers>
            </Label>
            <Label
                Grid.Column="1"
                Text="{Binding Title}"
                FontSize="24"
                FontFamily="OpenSansSemibold"
                LineBreakMode="TailTruncation"
                VerticalOptions="Center" />
        </Grid>

        <!-- The filter: above the list, not in it, so it stays in reach however far the list
             is scrolled. A row says what is applied; tapping it opens the panel in place. -->
        <VerticalStackLayout Grid.Row="1" Margin="16,12,16,0" Spacing="8">
            <Border Style="{StaticResource Card}" Padding="14,10">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ToggleFilterCommand}" />
                    </Grid.GestureRecognizers>
                    <Label Text="Filter" Style="{StaticResource Caption}" VerticalOptions="Center" />
                    <Label
                        Grid.Column="1"
                        Text="{Binding FilterSummary}"
                        FontFamily="OpenSansSemibold"
                        LineBreakMode="TailTruncation"
                        VerticalOptions="Center"
                        TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                    <!-- Drops the categories without opening the panel. -->
                    <Label
                        Grid.Column="2"
                        Text="✕"
                        FontSize="16"
                        Padding="8,0"
                        VerticalOptions="Center"
                        IsVisible="{Binding HasCategoryFilter}"
                        SemanticProperties.Description="Clear the category filter"
                        TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding RemoveCategoryFilterCommand}" />
                        </Label.GestureRecognizers>
                    </Label>
                    <Label
                        Grid.Column="3"
                        Text="▾"
                        FontSize="16"
                        VerticalOptions="Center"
                        TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                </Grid>
            </Border>

            <Border Style="{StaticResource Card}" IsVisible="{Binding IsFilterOpen}">
                <VerticalStackLayout Spacing="10">
                    <!-- One scrolling area, so a long category list or the month grid never pushes the buttons off screen. -->
                    <ScrollView MaximumHeightRequest="460">
                    <VerticalStackLayout Spacing="10">
                    <!-- Household tab only: which kind of accounts to list. One choice. -->
                    <Label Text="Accounts" Style="{StaticResource Caption}" IsVisible="{Binding IsHouseholdView}" />
                    <ScrollView
                        Orientation="Horizontal"
                        HorizontalScrollBarVisibility="Never"
                        IsVisible="{Binding IsHouseholdView}">
                        <HorizontalStackLayout BindableLayout.ItemsSource="{Binding Filters}" Spacing="6">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="transactions:ChoiceItem">
                                    <Border Style="{StaticResource Chip}">
                                        <Border.Triggers>
                                            <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                            </DataTrigger>
                                        </Border.Triggers>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding SelectFilterCommand, Source={RelativeSource AncestorType={x:Type transactions:TransactionsViewModel}}, x:DataType=transactions:TransactionsViewModel}"
                                                CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <Label Text="{Binding Label}" FontSize="13" FontFamily="OpenSansSemibold">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="TextColor" Value="White" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </HorizontalStackLayout>
                    </ScrollView>

                    <!-- Which days: all, a month, or a first and last day picked on a month grid. -->
                    <Label Text="Dates" Style="{StaticResource Caption}" />
                    <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                        <HorizontalStackLayout BindableLayout.ItemsSource="{Binding DateFilters}" Spacing="6">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="transactions:ChoiceItem">
                                    <Border Style="{StaticResource Chip}">
                                        <Border.Triggers>
                                            <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                            </DataTrigger>
                                        </Border.Triggers>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding SelectDatesCommand, Source={RelativeSource AncestorType={x:Type transactions:TransactionsViewModel}}, x:DataType=transactions:TransactionsViewModel}"
                                                CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <Label Text="{Binding Label}" FontSize="13" FontFamily="OpenSansSemibold">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="TextColor" Value="White" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </HorizontalStackLayout>
                    </ScrollView>
                    <ContentView IsVisible="{Binding IsPickingDates}">
                        <common:DateRangeCalendar BindingContext="{Binding DatePicker}" />
                    </ContentView>

                    <!-- Categories: any number. A long list scrolls inside the panel. -->
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Categories" Style="{StaticResource Caption}" VerticalOptions="Center" />
                        <Label
                            Grid.Column="1"
                            Text="Untick all"
                            FontSize="13"
                            VerticalOptions="Center"
                            TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ClearCategoriesCommand}" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding CategoryOptions}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="transactions:CategoryFilterOption">
                                    <Grid ColumnDefinitions="*,Auto" Padding="2,10">
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding ToggleCategoryCommand, Source={RelativeSource AncestorType={x:Type transactions:TransactionsViewModel}}, x:DataType=transactions:TransactionsViewModel}"
                                                CommandParameter="{Binding .}" />
                                        </Grid.GestureRecognizers>
                                        <Label Text="{Binding Label}" FontSize="15" />
                                        <Label
                                            Grid.Column="1"
                                            Text="✓"
                                            FontSize="16"
                                            IsVisible="{Binding IsSelected}"
                                            TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    <Label
                        Text="A category filter lists payments only: money coming in has no category."
                        Style="{StaticResource Caption}" />

                    <!-- Leaves out both halves of what the app recognises as moved between your own accounts. -->
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="0,4,0,0">
                        <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                            <Label Text="Hide transfers between your accounts" FontSize="15" />
                            <Label Text="The rows labelled &quot;Between your accounts&quot;." Style="{StaticResource Caption}" />
                        </VerticalStackLayout>
                        <Switch
                            Grid.Column="1"
                            IsToggled="{Binding StagedHideTransfers}"
                            VerticalOptions="Center" />
                    </Grid>

                    </VerticalStackLayout>
                    </ScrollView>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <Button Text="Show" Style="{StaticResource PrimaryButton}" Command="{Binding ApplyFilterCommand}" />
                        <Button Grid.Column="1" Text="Cancel" Style="{StaticResource SecondaryButton}" Command="{Binding ToggleFilterCommand}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>

    <RefreshView Grid.Row="2" IsRefreshing="{Binding IsRefreshing}" Command="{Binding LoadCommand}">
        <CollectionView
            x:Name="TransactionList"
            ItemsSource="{Binding Groups}"
            IsGrouped="True"
            SelectionMode="None"
            RemainingItemsThreshold="10"
            RemainingItemsThresholdReachedCommand="{Binding LoadMoreCommand}">

            <CollectionView.Header>
                <VerticalStackLayout Padding="16,12,16,0" Spacing="12">


                    <!-- One account: its type, as a dropdown that opens in place. -->
                    <Border Style="{StaticResource Card}" Padding="16,12" IsVisible="{Binding IsAccountView}">
                        <VerticalStackLayout Spacing="4">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ToggleTypeMenuCommand}" />
                                </Grid.GestureRecognizers>
                                <Label Text="Account type" Style="{StaticResource Caption}" VerticalOptions="Center" />
                                <Label
                                    Grid.Column="1"
                                    Text="{Binding AccountTypeSummary}"
                                    FontSize="16"
                                    FontFamily="OpenSansSemibold"
                                    TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                            </Grid>
                            <VerticalStackLayout
                                BindableLayout.ItemsSource="{Binding AccountTypes}"
                                IsVisible="{Binding IsTypeMenuOpen}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="transactions:ChoiceItem">
                                        <Grid ColumnDefinitions="*,Auto" Padding="0,12,0,4">
                                            <Grid.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding SelectAccountTypeCommand, Source={RelativeSource AncestorType={x:Type transactions:TransactionsViewModel}}, x:DataType=transactions:TransactionsViewModel}"
                                                    CommandParameter="{Binding .}" />
                                            </Grid.GestureRecognizers>
                                            <Label Text="{Binding Label}" FontSize="16" />
                                            <Label
                                                Grid.Column="1"
                                                Text="✓"
                                                FontSize="16"
                                                IsVisible="{Binding IsSelected}"
                                                TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <Label
                        Text="{Binding Error}"
                        Style="{StaticResource ErrorText}"
                        IsVisible="{Binding Error, Converter={StaticResource HasText}}" />
                    <Label
                        Text="Nothing here yet."
                        Style="{StaticResource Caption}"
                        Margin="4,0"
                        IsVisible="{Binding IsEmpty}" />

                    <!-- An investment account: what it holds. -->
                    <Label Text="Holdings" Style="{StaticResource SectionTitle}" IsVisible="{Binding HasHoldings}" />
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Holdings}" Spacing="6">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="transactions:HoldingItem">
                                <Border Style="{StaticResource Card}" Padding="16,12">
                                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="2">
                                        <Label Text="{Binding Name}" Style="{StaticResource RowTitle}" />
                                        <Label
                                            Grid.Column="1"
                                            Text="{Binding Value}"
                                            FontSize="16"
                                            FontFamily="OpenSansSemibold"
                                            HorizontalTextAlignment="End" />
                                        <Label Grid.Row="1" Text="{Binding Detail}" Style="{StaticResource Caption}" />
                                        <Label
                                            Grid.Row="1"
                                            Grid.Column="1"
                                            Text="{Binding ProfitLoss}"
                                            Style="{StaticResource Caption}"
                                            HorizontalTextAlignment="End">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsGain}" Value="True">
                                                    <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Positive}, Dark={StaticResource PositiveDark}}" />
                                                </DataTrigger>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsLoss}" Value="True">
                                                    <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Negative}, Dark={StaticResource NegativeDark}}" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </CollectionView.Header>

            <CollectionView.GroupHeaderTemplate>
                <DataTemplate x:DataType="transactions:TransactionGroup">
                    <Label Text="{Binding Title}" Style="{StaticResource SectionTitle}" Margin="20,16,20,6" />
                </DataTemplate>
            </CollectionView.GroupHeaderTemplate>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="transactions:TransactionItem">
                    <Grid Padding="16,3">
                        <Border Style="{StaticResource Card}" Padding="16,12">
                            <!-- Tapping a row opens it: full texts, and for a payment its choices underneath. -->
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding ToggleMenuCommand, Source={RelativeSource AncestorType={x:Type transactions:TransactionsViewModel}}, x:DataType=transactions:TransactionsViewModel}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="2">
                                <!-- Who made it -->
                                <Border
                                    Grid.RowSpan="2"
                                    WidthRequest="36"
                                    HeightRequest="36"
                                    StrokeThickness="0"
                                    StrokeShape="Ellipse"
                                    VerticalOptions="Center"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource AvatarBackground}, Dark={StaticResource AvatarBackgroundDark}}">
                                    <Grid>
                                        <Label
                                            Text="{Binding OwnerInitial}"
                                            FontSize="15"
                                            FontFamily="OpenSansSemibold"
                                            HorizontalOptions="Center"
                                            VerticalOptions="Center"
                                            TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                                        <!-- Covers the initial once the picture has loaded. -->
                                        <Image Source="{Binding OwnerAvatarUrl}" Aspect="AspectFill" />
                                    </Grid>
                                </Border>
                                <Label Grid.Column="1" Text="{Binding Title}" Style="{StaticResource RowTitle}">
                                    <Label.Triggers>
                                        <!-- Open: the whole text, on as many lines as it needs. -->
                                        <DataTrigger TargetType="Label" Binding="{Binding IsMenuOpen}" Value="True">
                                            <Setter Property="LineBreakMode" Value="WordWrap" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                                <Label
                                    Grid.Column="2"
                                    Text="{Binding Amount}"
                                    FontSize="16"
                                    FontFamily="OpenSansSemibold"
                                    VerticalOptions="Center">
                                    <Label.Triggers>
                                        <!-- Faded while pending: not money that has moved yet. -->
                                        <DataTrigger TargetType="Label" Binding="{Binding IsPending}" Value="True">
                                            <Setter Property="Opacity" Value="0.55" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsIncome}" Value="True">
                                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Positive}, Dark={StaticResource PositiveDark}}" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                                <Label
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Grid.ColumnSpan="2"
                                    Text="{Binding Subtitle}"
                                    Style="{StaticResource Caption}"
                                    LineBreakMode="TailTruncation">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsMenuOpen}" Value="True">
                                            <Setter Property="LineBreakMode" Value="WordWrap" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>

                                <!-- What sets this payment apart: its category, and what its payee is marked as. -->
                                <HorizontalStackLayout Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Spacing="10">
                                    <!-- Not booked yet: in no figure, and it may still change. -->
                                    <Border
                                        Padding="7,1"
                                        StrokeThickness="1"
                                        StrokeShape="RoundRectangle 8"
                                        VerticalOptions="Center"
                                        BackgroundColor="Transparent"
                                        Stroke="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                        IsVisible="{Binding IsPending}">
                                        <Label
                                            Text="⏳ Pending"
                                            FontSize="11"
                                            FontFamily="OpenSansSemibold"
                                            TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                                    </Border>
                                    <Label
                                        Text="{Binding Category}"
                                        FontSize="12"
                                        FontFamily="OpenSansSemibold"
                                        IsVisible="{Binding HasCategory}"
                                        TextColor="{StaticResource Accent}" />
                                    <Label
                                        Text="{Binding RecurringLabel}"
                                        FontSize="12"
                                        FontFamily="OpenSansSemibold"
                                        IsVisible="{Binding IsTracked}"
                                        TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                                    <!-- Recognised by the app itself, on both halves: nothing for the user to do. -->
                                    <Label
                                        Text="Between your accounts"
                                        FontSize="12"
                                        FontFamily="OpenSansSemibold"
                                        IsVisible="{Binding IsInternalTransfer}"
                                        TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                                </HorizontalStackLayout>

                                <!-- The choices: what every payment to this payee is. -->
                                <VerticalStackLayout Grid.Row="3" Grid.ColumnSpan="3" Spacing="8" Margin="0,10,0,2" IsVisible="{Binding IsTrackMenuOpen}">
                                    <Label
                                        Text="Joint recognised this as money moved between your own accounts, so it is not counted as spending. There is no need to mark it as an own transfer."
                                        Style="{StaticResource Caption}"
                                        IsVisible="{Binding IsInternalTransfer}" />
                                    <!-- The category is chosen on its own page: the list can be long. -->
                                    <Border Style="{StaticResource InsetRow}">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding OpenCategoryCommand, Source={RelativeSource AncestorType={x:Type transactions:TransactionsViewModel}}, x:DataType=transactions:TransactionsViewModel}"
                                                CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                            <Label Text="Category" VerticalOptions="Center" />
                                            <Label
                                                Grid.Column="1"
                                                Text="{Binding CategoryChoice}"
                                                FontFamily="OpenSansSemibold"
                                                VerticalOptions="Center"
                                                TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                                            <Label
                                                Grid.Column="2"
                                                Text="›"
                                                FontSize="20"
                                                VerticalOptions="Center"
                                                TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                                        </Grid>
                                    </Border>
                                    <Label Text="Count every payment containing" Style="{StaticResource Caption}" />
                                    <!-- Pre-filled with a guess; edit it when the bank adds something that changes each time. -->
                                    <Border Style="{StaticResource Field}">
                                        <Entry
                                            Text="{Binding MatchText}"
                                            Placeholder="Text every payment has in common"
                                            IsSpellCheckEnabled="False"
                                            IsTextPredictionEnabled="False"
                                            ReturnType="Done" />
                                    </Border>
                                    <Label Text="as" Style="{StaticResource Caption}" />
                                    <HorizontalStackLayout Spacing="6">
                                        <Border Style="{StaticResource Chip}">
                                            <Border.Triggers>
                                                <DataTrigger TargetType="Border" Binding="{Binding IsSubscription}" Value="True">
                                                    <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                                </DataTrigger>
                                            </Border.Triggers>
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding MarkSubscriptionCommand, Source={RelativeSource AncestorType={x:Type transactions:TransactionsViewModel}}, x:DataType=transactions:TransactionsViewModel}"
                                                    CommandParameter="{Binding .}" />
                                            </Border.GestureRecognizers>
                                            <Label Text="Subscription" FontSize="13" FontFamily="OpenSansSemibold">
                                                <Label.Triggers>
                                                    <DataTrigger TargetType="Label" Binding="{Binding IsSubscription}" Value="True">
                                                        <Setter Property="TextColor" Value="White" />
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>
                                        </Border>
                                        <Border Style="{StaticResource Chip}">
                                            <Border.Triggers>
                                                <DataTrigger TargetType="Border" Binding="{Binding IsBill}" Value="True">
                                                    <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                                </DataTrigger>
                                            </Border.Triggers>
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding MarkBillCommand, Source={RelativeSource AncestorType={x:Type transactions:TransactionsViewModel}}, x:DataType=transactions:TransactionsViewModel}"
                                                    CommandParameter="{Binding .}" />
                                            </Border.GestureRecognizers>
                                            <Label Text="Regular payment" FontSize="13" FontFamily="OpenSansSemibold">
                                                <Label.Triggers>
                                                    <DataTrigger TargetType="Label" Binding="{Binding IsBill}" Value="True">
                                                        <Setter Property="TextColor" Value="White" />
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>
                                        </Border>
                                    </HorizontalStackLayout>
                                    <!-- A second row: four chips do not fit across a phone. -->
                                    <HorizontalStackLayout Spacing="6">
                                        <!-- Not a cost at all: money moved to an own account Joint cannot pair up. -->
                                        <Border Style="{StaticResource Chip}">
                                            <Border.Triggers>
                                                <DataTrigger TargetType="Border" Binding="{Binding IsTransfer}" Value="True">
                                                    <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                                </DataTrigger>
                                            </Border.Triggers>
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding MarkTransferCommand, Source={RelativeSource AncestorType={x:Type transactions:TransactionsViewModel}}, x:DataType=transactions:TransactionsViewModel}"
                                                    CommandParameter="{Binding .}" />
                                            </Border.GestureRecognizers>
                                            <Label Text="Own transfer" FontSize="13" FontFamily="OpenSansSemibold">
                                                <Label.Triggers>
                                                    <DataTrigger TargetType="Label" Binding="{Binding IsTransfer}" Value="True">
                                                        <Setter Property="TextColor" Value="White" />
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>
                                        </Border>
                                        <Border Style="{StaticResource Chip}" BackgroundColor="Transparent" IsVisible="{Binding IsTracked}">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding StopTrackingCommand, Source={RelativeSource AncestorType={x:Type transactions:TransactionsViewModel}}, x:DataType=transactions:TransactionsViewModel}"
                                                    CommandParameter="{Binding .}" />
                                            </Border.GestureRecognizers>
                                            <Label
                                                Text="Stop tracking"
                                                FontSize="13"
                                                FontFamily="OpenSansSemibold"
                                                TextColor="{AppThemeBinding Light={StaticResource Negative}, Dark={StaticResource NegativeDark}}" />
                                        </Border>
                                    </HorizontalStackLayout>

                                    <Label
                                        Text="Own transfer is for money moved to an account of yours that Joint cannot match up, such as Trading 212: it stops counting as spending everywhere."
                                        Style="{StaticResource Caption}"
                                        Margin="0,6,0,0" />
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </RefreshView>
    </Grid>

</ContentPage>
