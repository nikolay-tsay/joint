<ContentPage
    x:Class="Joint.Mobile.Features.Transactions.TransactionsPage"
    xmlns:transactions="clr-namespace:Joint.Mobile.Features.Transactions"
    x:DataType="transactions:TransactionsViewModel"
    Title="{Binding Title}"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}">

    <Grid RowDefinitions="Auto,*">

        <!-- The page's own heading. Shell's navigation bar is off: it tints the strip behind the
             clock purple, which no other page has. Opened from an account, the heading carries the
             way back that the bar used to. It sits above the list, not in the list's header, where
             its top spacing was lost and it ran into the status bar. -->
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="4" Margin="16,24,16,0">
            <Label
                Text="‹"
                FontSize="30"
                Padding="0,0,12,4"
                VerticalOptions="Center"
                IsVisible="{Binding IsAccountView}"
                SemanticProperties.Description="Back"
                TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding GoBackCommand}" />
                </Label.GestureRecognizers>
            </Label>
            <Label
                Grid.Column="1"
                Text="{Binding Title}"
                FontSize="24"
                FontFamily="OpenSansSemibold"
                LineBreakMode="TailTruncation"
                VerticalOptions="Center" />
        </Grid>

    <RefreshView Grid.Row="1" IsRefreshing="{Binding IsRefreshing}" Command="{Binding LoadCommand}">
        <CollectionView
            ItemsSource="{Binding Groups}"
            IsGrouped="True"
            SelectionMode="None"
            RemainingItemsThreshold="10"
            RemainingItemsThresholdReachedCommand="{Binding LoadMoreCommand}">

            <CollectionView.Header>
                <VerticalStackLayout Padding="16,12,16,0" Spacing="12">


                    <!-- Household tab: which kind of accounts to list. -->
                    <!-- One line; scrolls sideways if the chips ever outgrow the screen. -->
                    <ScrollView
                        Orientation="Horizontal"
                        HorizontalScrollBarVisibility="Never"
                        IsVisible="{Binding IsHouseholdView}">
                    <HorizontalStackLayout BindableLayout.ItemsSource="{Binding Filters}" Spacing="6">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="transactions:ChoiceItem">
                                <Border
                                    Padding="11,5"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 15"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding SelectFilterCommand, Source={RelativeSource AncestorType={x:Type transactions:TransactionsViewModel}}, x:DataType=transactions:TransactionsViewModel}"
                                            CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <Label Text="{Binding Label}" FontSize="13" FontFamily="OpenSansSemibold">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="TextColor" Value="White" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </HorizontalStackLayout>
                    </ScrollView>

                    <!-- One account: its type, as a dropdown that opens in place. -->
                    <Border Style="{StaticResource Card}" Padding="16,12" IsVisible="{Binding IsAccountView}">
                        <VerticalStackLayout Spacing="4">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ToggleTypeMenuCommand}" />
                                </Grid.GestureRecognizers>
                                <Label Text="Account type" Style="{StaticResource Caption}" VerticalOptions="Center" />
                                <Label
                                    Grid.Column="1"
                                    Text="{Binding AccountTypeSummary}"
                                    FontSize="16"
                                    FontFamily="OpenSansSemibold"
                                    TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                            </Grid>
                            <VerticalStackLayout
                                BindableLayout.ItemsSource="{Binding AccountTypes}"
                                IsVisible="{Binding IsTypeMenuOpen}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="transactions:ChoiceItem">
                                        <Grid ColumnDefinitions="*,Auto" Padding="0,12,0,4">
                                            <Grid.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding SelectAccountTypeCommand, Source={RelativeSource AncestorType={x:Type transactions:TransactionsViewModel}}, x:DataType=transactions:TransactionsViewModel}"
                                                    CommandParameter="{Binding .}" />
                                            </Grid.GestureRecognizers>
                                            <Label Text="{Binding Label}" FontSize="16" />
                                            <Label
                                                Grid.Column="1"
                                                Text="✓"
                                                FontSize="16"
                                                IsVisible="{Binding IsSelected}"
                                                TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <Label
                        Text="{Binding Error}"
                        Style="{StaticResource ErrorText}"
                        IsVisible="{Binding Error, Converter={StaticResource HasText}}" />
                    <Label
                        Text="Nothing here yet."
                        Style="{StaticResource Caption}"
                        Margin="4,0"
                        IsVisible="{Binding IsEmpty}" />

                    <!-- An investment account: what it holds. -->
                    <Label Text="Holdings" Style="{StaticResource SectionTitle}" IsVisible="{Binding HasHoldings}" />
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Holdings}" Spacing="6">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="transactions:HoldingItem">
                                <Border Style="{StaticResource Card}" Padding="16,12">
                                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="2">
                                        <Label Text="{Binding Name}" Style="{StaticResource RowTitle}" />
                                        <Label
                                            Grid.Column="1"
                                            Text="{Binding Value}"
                                            FontSize="16"
                                            FontFamily="OpenSansSemibold"
                                            HorizontalTextAlignment="End" />
                                        <Label Grid.Row="1" Text="{Binding Detail}" Style="{StaticResource Caption}" />
                                        <Label
                                            Grid.Row="1"
                                            Grid.Column="1"
                                            Text="{Binding ProfitLoss}"
                                            Style="{StaticResource Caption}"
                                            HorizontalTextAlignment="End">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsGain}" Value="True">
                                                    <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Positive}, Dark={StaticResource PositiveDark}}" />
                                                </DataTrigger>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsLoss}" Value="True">
                                                    <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Negative}, Dark={StaticResource NegativeDark}}" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </CollectionView.Header>

            <CollectionView.GroupHeaderTemplate>
                <DataTemplate x:DataType="transactions:TransactionGroup">
                    <Label Text="{Binding Title}" Style="{StaticResource SectionTitle}" Margin="20,16,20,6" />
                </DataTemplate>
            </CollectionView.GroupHeaderTemplate>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="transactions:TransactionItem">
                    <Grid Padding="16,3">
                        <Border Style="{StaticResource Card}" Padding="16,12">
                            <!-- Tapping a row opens it: full texts, and for a payment its choices underneath. -->
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding ToggleMenuCommand, Source={RelativeSource AncestorType={x:Type transactions:TransactionsViewModel}}, x:DataType=transactions:TransactionsViewModel}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="2">
                                <!-- Who made it -->
                                <Border
                                    Grid.RowSpan="2"
                                    WidthRequest="36"
                                    HeightRequest="36"
                                    StrokeThickness="0"
                                    StrokeShape="Ellipse"
                                    VerticalOptions="Center"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource AvatarBackground}, Dark={StaticResource AvatarBackgroundDark}}">
                                    <Grid>
                                        <Label
                                            Text="{Binding OwnerInitial}"
                                            FontSize="15"
                                            FontFamily="OpenSansSemibold"
                                            HorizontalOptions="Center"
                                            VerticalOptions="Center"
                                            TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                                        <!-- Covers the initial once the picture has loaded. -->
                                        <Image Source="{Binding OwnerAvatarUrl}" Aspect="AspectFill" />
                                    </Grid>
                                </Border>
                                <Label Grid.Column="1" Text="{Binding Title}" Style="{StaticResource RowTitle}">
                                    <Label.Triggers>
                                        <!-- Open: the whole text, on as many lines as it needs. -->
                                        <DataTrigger TargetType="Label" Binding="{Binding IsMenuOpen}" Value="True">
                                            <Setter Property="LineBreakMode" Value="WordWrap" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                                <Label
                                    Grid.Column="2"
                                    Text="{Binding Amount}"
                                    FontSize="16"
                                    FontFamily="OpenSansSemibold"
                                    VerticalOptions="Center">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsIncome}" Value="True">
                                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Positive}, Dark={StaticResource PositiveDark}}" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                                <Label
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Grid.ColumnSpan="2"
                                    Text="{Binding Subtitle}"
                                    Style="{StaticResource Caption}"
                                    LineBreakMode="TailTruncation">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsMenuOpen}" Value="True">
                                            <Setter Property="LineBreakMode" Value="WordWrap" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>

                                <!-- What sets this payment apart: tracked as recurring, or kept out of the budget. -->
                                <HorizontalStackLayout Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Spacing="10">
                                    <Label
                                        Text="{Binding Category}"
                                        FontSize="12"
                                        FontFamily="OpenSansSemibold"
                                        IsVisible="{Binding HasCategory}"
                                        TextColor="{StaticResource Accent}" />
                                    <Label
                                        Text="{Binding RecurringLabel}"
                                        FontSize="12"
                                        FontFamily="OpenSansSemibold"
                                        IsVisible="{Binding IsTracked}"
                                        TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                                    <Label
                                        Text="Not in budget"
                                        FontSize="12"
                                        FontFamily="OpenSansSemibold"
                                        IsVisible="{Binding IsExcludedFromBudget}"
                                        TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                                </HorizontalStackLayout>

                                <!-- The choices: what every payment to this payee is. -->
                                <VerticalStackLayout Grid.Row="3" Grid.ColumnSpan="3" Spacing="8" Margin="0,10,0,2" IsVisible="{Binding IsTrackMenuOpen}">
                                    <!-- The category is chosen on its own page: the list can be long. -->
                                    <Border Style="{StaticResource InsetRow}">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding OpenCategoryCommand, Source={RelativeSource AncestorType={x:Type transactions:TransactionsViewModel}}, x:DataType=transactions:TransactionsViewModel}"
                                                CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                            <Label Text="Category" VerticalOptions="Center" />
                                            <Label
                                                Grid.Column="1"
                                                Text="{Binding CategoryChoice}"
                                                FontFamily="OpenSansSemibold"
                                                VerticalOptions="Center"
                                                TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                                            <Label
                                                Grid.Column="2"
                                                Text="›"
                                                FontSize="20"
                                                VerticalOptions="Center"
                                                TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                                        </Grid>
                                    </Border>
                                    <Label Text="Count every payment containing" Style="{StaticResource Caption}" />
                                    <!-- Pre-filled with a guess; edit it when the bank adds something that changes each time. -->
                                    <Border Style="{StaticResource Field}">
                                        <Entry
                                            Text="{Binding MatchText}"
                                            Placeholder="Text every payment has in common"
                                            IsSpellCheckEnabled="False"
                                            IsTextPredictionEnabled="False"
                                            ReturnType="Done" />
                                    </Border>
                                    <Label Text="as" Style="{StaticResource Caption}" />
                                    <HorizontalStackLayout Spacing="6">
                                        <Border Style="{StaticResource Chip}">
                                            <Border.Triggers>
                                                <DataTrigger TargetType="Border" Binding="{Binding IsSubscription}" Value="True">
                                                    <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                                </DataTrigger>
                                            </Border.Triggers>
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding MarkSubscriptionCommand, Source={RelativeSource AncestorType={x:Type transactions:TransactionsViewModel}}, x:DataType=transactions:TransactionsViewModel}"
                                                    CommandParameter="{Binding .}" />
                                            </Border.GestureRecognizers>
                                            <Label Text="Subscription" FontSize="13" FontFamily="OpenSansSemibold">
                                                <Label.Triggers>
                                                    <DataTrigger TargetType="Label" Binding="{Binding IsSubscription}" Value="True">
                                                        <Setter Property="TextColor" Value="White" />
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>
                                        </Border>
                                        <Border Style="{StaticResource Chip}">
                                            <Border.Triggers>
                                                <DataTrigger TargetType="Border" Binding="{Binding IsBill}" Value="True">
                                                    <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                                </DataTrigger>
                                            </Border.Triggers>
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding MarkBillCommand, Source={RelativeSource AncestorType={x:Type transactions:TransactionsViewModel}}, x:DataType=transactions:TransactionsViewModel}"
                                                    CommandParameter="{Binding .}" />
                                            </Border.GestureRecognizers>
                                            <Label Text="Regular payment" FontSize="13" FontFamily="OpenSansSemibold">
                                                <Label.Triggers>
                                                    <DataTrigger TargetType="Label" Binding="{Binding IsBill}" Value="True">
                                                        <Setter Property="TextColor" Value="White" />
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>
                                        </Border>
                                        <Border Style="{StaticResource Chip}" BackgroundColor="Transparent" IsVisible="{Binding IsTracked}">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding StopTrackingCommand, Source={RelativeSource AncestorType={x:Type transactions:TransactionsViewModel}}, x:DataType=transactions:TransactionsViewModel}"
                                                    CommandParameter="{Binding .}" />
                                            </Border.GestureRecognizers>
                                            <Label
                                                Text="Stop tracking"
                                                FontSize="13"
                                                FontFamily="OpenSansSemibold"
                                                TextColor="{AppThemeBinding Light={StaticResource Negative}, Dark={StaticResource NegativeDark}}" />
                                        </Border>
                                    </HorizontalStackLayout>

                                    <!-- The manual correction for the budget. -->
                                    <Label
                                        Text="If this is not everyday spending, such as money moved to an account Joint cannot see, keep it out of the budget."
                                        Style="{StaticResource Caption}"
                                        Margin="0,6,0,0" />
                                    <HorizontalStackLayout>
                                        <Border Style="{StaticResource Chip}">
                                            <Border.Triggers>
                                                <DataTrigger TargetType="Border" Binding="{Binding IsExcludedFromBudget}" Value="True">
                                                    <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                                </DataTrigger>
                                            </Border.Triggers>
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding ToggleBudgetExclusionCommand, Source={RelativeSource AncestorType={x:Type transactions:TransactionsViewModel}}, x:DataType=transactions:TransactionsViewModel}"
                                                    CommandParameter="{Binding .}" />
                                            </Border.GestureRecognizers>
                                            <Label Text="{Binding BudgetChoice}" FontSize="13" FontFamily="OpenSansSemibold">
                                                <Label.Triggers>
                                                    <DataTrigger TargetType="Label" Binding="{Binding IsExcludedFromBudget}" Value="True">
                                                        <Setter Property="TextColor" Value="White" />
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>
                                        </Border>
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </RefreshView>
    </Grid>

</ContentPage>
