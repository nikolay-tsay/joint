<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net11.0-android</TargetFramework>
		<OutputType>Exe</OutputType>
		<RootNamespace>Joint.Mobile</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>

		<ApplicationTitle>Joint</ApplicationTitle>
		<ApplicationId>app.joint.mobile</ApplicationId>
		<ApplicationDisplayVersion>0.1</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<SupportedOSPlatformVersion>24.0</SupportedOSPlatformVersion>
	</PropertyGroup>

	<!-- A Debug build is a separate app next to the released one, so installing it over USB
	     does not replace the APK in daily use. It also signs in through its own redirect scheme
	     (AppConfig.AuthCallbackScheme), or Android would ask which of the two to open. -->
	<PropertyGroup Condition="'$(Configuration)' == 'Debug'">
		<ApplicationTitle>Joint Dev</ApplicationTitle>
		<ApplicationId>app.joint.mobile.dev</ApplicationId>
	</PropertyGroup>

	<ItemGroup>
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#6D28D9" />
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#F6F4FA" BaseSize="192,192" />
		<MauiImage Include="Resources\Images\*" />
		<MauiFont Include="Resources\Fonts\*" />
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="11.0.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Joint.Contracts\Joint.Contracts.csproj" />
	</ItemGroup>

</Project>
